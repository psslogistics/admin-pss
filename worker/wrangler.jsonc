{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pss-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "psslogisticsdatabase",
      "database_id": "798a571d-5e56-45a0-85f8-8d71bad284e9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pss-private-files"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://psslogistics.in,https://www.psslogistics.in,https://client.psslogistics.in,https://admin.psslogistics.in,https://master.psslogistics.in,https://hero-pss.vercel.app,https://client-pss.vercel.app,https://admin-pss.vercel.app,https://master-pss.vercel.app",
    "SUPABASE_URL": "https://qyelfkmafzspctqkrwxf.supabase.co",
    "DELHIVERY_API_BASE_URL": "https://track.delhivery.com/api/v1",
    "DELHIVERY_CLIENT_NAME": "PSS LOGISTICS",
    "DELHIVERY_DEFAULT_PICKUP_LOCATION": "PSS B2C",
    "DELHIVERY_ENABLE_SHIPMENT_CREATION": "true",
    "DELHIVERY_ENABLE_PICKUP_CREATION": "true",
    "EKART_API_BASE_URL": "https://api.ekartlogistics.com",
    "EKART_ENABLE_PROVIDER_CALLS": "false",
    "TRACKON_API_BASE_URL": "http://trackon.in:5455",
    "TRACKON_TRACKING_URL": "http://trackoncourier.com:5455/CrmApi/t1/AWBTrackingCustomer",
    "TRACKON_BOOKING_URL": "http://trackon.in:5455/CrmApi/Crm/UploadPickupRequestWithoutDockNo",
    "TRACKON_LABEL_URL": "http://trackon.in:5456/CrmApi/Crm/GenerateSoftdataLabel3x3",
    "TRACKON_ENABLE_SHIPMENT_CREATION": "false",
    "TRACKON_ENABLE_PICKUP_CREATION": "false",
    "XPRESSBEES_API_BASE_URL": "https://ship.xpressbees.com/api",
    "XPRESSBEES_ENABLE_SHIPMENT_CREATION": "false",
    "XPRESSBEES_ENABLE_PICKUP_CREATION": "false",
    "ENABLE_PROVIDER_CALLS": "true"
  }
}
